{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/.next", "!**/node_modules", "!**/playwright-report", "!**/test-results"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react/**", "react-dom", "react-dom/**"],
              [":PACKAGE:", ":NODE:"],
              ":BLANK_LINE:",
              ["@/**"],
              ":BLANK_LINE:",
              [":PATH:"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "interface" },
                "match": "I(.+)",
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "typeAlias" },
                "match": "T(.+)",
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "enumMember" },
                "formats": ["CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              }
            ]
          }
        }
      },
      "suspicious": { "noConsole": "error" },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": { "maxLines": 40 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": { "level": "warn", "options": { "maxLines": 150 } }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "linter": {
        "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } }
      }
    },
    {
      "includes": ["src/app/**", "**/*.config.*", "src/instrumentation.ts"],
      "linter": {
        "rules": { "style": { "useNamingConvention": "off" } }
      }
    },
    {
      "includes": ["src/common/components/ui/**"],
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["src/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["@/modules", "@/modules/**"], "message": "api não importa modules." }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/api/resources/*/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["@/modules", "@/modules/**"], "message": "api não importa modules." },
                  {
                    "group": ["**/client/**", "../client/**"],
                    "message": "server/ não importa client/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules", "@/modules/**", "@/api", "@/api/**"],
                    "message": "infrastructure só importa common."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/common/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules",
                      "@/modules/**",
                      "@/api",
                      "@/api/**",
                      "@/infrastructure",
                      "@/infrastructure/**"
                    ],
                    "message": "common só importa common."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "src/modules/**", "src/providers/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules/*/**"],
                    "message": "Importe o módulo só pelo index.ts (@/modules/<modulo>)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
